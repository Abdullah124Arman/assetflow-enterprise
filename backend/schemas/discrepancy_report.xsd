<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="discrepancy_report">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="audit_cycle_id" type="xs:string"/>
        <xs:element name="generated_at" type="xs:dateTime"/>
        <xs:element name="missing_items">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="asset" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="id" type="xs:string"/>
                    <xs:element name="tag" type="xs:string"/>
                    <xs:element name="name" type="xs:string"/>
                    <xs:element name="notes" type="xs:string" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="damaged_items">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="asset" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="id" type="xs:string"/>
                    <xs:element name="tag" type="xs:string"/>
                    <xs:element name="name" type="xs:string"/>
                    <xs:element name="notes" type="xs:string" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
