<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="transfer_request">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="asset_id" type="xs:string"/>
        <xs:element name="from_holder_id" type="xs:string"/>
        <xs:element name="to_holder_id" type="xs:string"/>
        <xs:element name="reason" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
