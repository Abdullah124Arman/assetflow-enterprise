<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="allocation_request">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="asset_id" type="xs:string"/>
        <xs:element name="holder_type">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="employee"/>
              <xs:enumeration value="department"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="holder_id" type="xs:string"/>
        <xs:element name="expected_return_date" type="xs:date" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
