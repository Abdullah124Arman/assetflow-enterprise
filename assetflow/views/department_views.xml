<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Department Form View -->
        <record id="view_assetflow_department_form" model="ir.ui.view">
            <field name="name">assetflow.department.form</field>
            <field name="model">assetflow.department</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Department Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="parent_id"/>
                                <field name="manager_id"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Department Tree View -->
        <record id="view_assetflow_department_tree" model="ir.ui.view">
            <field name="name">assetflow.department.tree</field>
            <field name="model">assetflow.department</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="manager_id"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <!-- Department Action -->
        <record id="action_assetflow_department" model="ir.actions.act_window">
            <field name="name">Departments</field>
            <field name="res_model">assetflow.department</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_assetflow_departments"
                  name="Departments"
                  parent="menu_assetflow_org_setup"
                  action="action_assetflow_department"
                  sequence="10"/>
    </data>
</odoo>
